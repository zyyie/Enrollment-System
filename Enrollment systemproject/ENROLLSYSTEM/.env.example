# Geranova EMS — STUDENT PORTAL ONLY
# Copy to .env and fill in values. Never commit .env.

# Supabase (Publishable key for browser; Secret key for server-side login/submit)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Gmail SMTP — enrollment confirmation emails
GMAIL_USER=your-school-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
ADMIN_EMAIL=your-school-email@gmail.com
SCHOOL_NAME=Geranova Senior High School

# GCash payment
GCASH_MERCHANT_NAME=Geranova Senior High School
GCASH_MERCHANT_NUMBER=0917 123 4567
GCASH_QR_IMAGE=assets/gcash-qr.png
ENROLLMENT_FEE=2500

# Optional: port override (default 8000)
# PORT=8000

# Admin portal URL (shown on student landing page)
ADMIN_PORTAL_URL=http://localhost:8001
